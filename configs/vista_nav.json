{
  "protocol": "vista_skill_nav_eval_2026_08_12",
  "task_manifest": "configs/vista_nav_manifest.json",
  "evolution_seeds": [0, 1, 2],
  "environment": {
    "name": "eb-nav",
    "note": "EB-Navigation ships no train_validation split; evaluate uses official_test on the subsets below.",
    "final_test_subsets": [
      "base",
      "common_sense",
      "complex_instruction",
      "visual_appearance",
      "long_horizon"
    ],
    "resolution": 500
  },
  "executor": {
    "model": "Qwen3-VL-8B-Instruct",
    "model_type": "remote",
    "tensor_parallel": 1,
    "frozen": true,
    "precision": "fp8",
    "max_model_len": 16384,
    "max_completion_tokens": 1024,
    "n_shots": 3,
    "temperature": 0.0
  },
  "budgets": {
    "active_skill_words": 512,
    "ledger_predicates": 24,
    "history_actions": 12,
    "patch_operations_per_round": 1,
    "proxy_episodes": 10,
    "finalist_episodes": 30
  },
  "credit": {
    "targets": ["belief_refresh", "skill_update", "abstain"],
    "action_model_updates_enabled": false,
    "min_independent_episodes": 2,
    "min_evidence_confidence": 0.75,
    "min_attribution_confidence": 0.7
  },
  "gate": {
    "bootstrap_samples": 2000,
    "alpha": 0.05,
    "proxy_lcb_threshold": 0.0,
    "finalist_lcb_threshold": 0.0,
    "subgroup_regression_tolerance": 0.05
  },
  "final_test": {
    "skill_frozen": true,
    "teacher_enabled": false,
    "attribution_enabled": false,
    "patching_enabled": false
  }
}
